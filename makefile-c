##############################################################################
################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of PBeFS                                               #
#                                                                            #
#   The makefile defines internally all the external libraries required by   #
#   the parallel runtimes of PBeFS: the threads, OpenMP and the              #
#   headers of FastFlow (in $(FF_ROOT), /opt/fastflow by default).           #
#   MPI is not here: what includes HDAStarMPI.h is compiled with mpicxx.     #
#   Accordingly, all necessary H, -I directives and external libraries are   #
#   added to the corresponding PBeFS* macros.                                #
#                                                                            #
#   Input:  $(CC)      = compiler command                                    #
#           $(SW)      = compiler options                                    #
#           $(PBeFSSDR)  = the directory where PBeFS is                      #
#                                                                            #
#   Output: $(PBeFSOBJ)  = the final object(s) / library                     #
#           $(PBeFSLIB)  = external libraries + -L< libdirs >                #
#           $(PBeFSH)    = the .h files to include                           #
#           $(PBeFSINC)  = the -I$( include directories )                    #
#           $(PBeFSDEF)  = the -D of the runtimes that are there             #
#                                                                            #
#                                Donato Meoli                                #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# include the makefile of the library - - - - - - - - - - - - - - - - - - - -

include $(PBeFSSDR)/makefile

# the external libraries- - - - - - - - - - - - - - - - - - - - - - - - - - -

# FastFlow: its headers only, as system headers, so that their warnings
# do not drown ours
FF_ROOT ?= /opt/fastflow

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append the external -I directives to PBeFSINC and PBeFSH as defined by the
# makefile, thus the := assignment has to be used (use GNU make)
PBeFSINC := $(PBeFSINC) -isystem $(FF_ROOT)
PBeFSH := $(PBeFSH) $(PBeFSOMPH) $(PBeFSFFH)
PBeFSDEF = -DPBEFS_HAS_OPENMP -DPBEFS_HAS_FASTFLOW -DNO_DEFAULT_MAPPING

# external libraries for PBeFS
PBeFSLIB = -pthread -fopenmp

############################ End of makefile #################################
