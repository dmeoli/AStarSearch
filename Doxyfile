# --------------------------------------------------------------------------- #
#    Doxyfile of AStarSearch                                                  #
#                                                                             #
#    The API reference of AStarSearch: the headers of include/ and the        #
#    definitions of src/, the README as the main page, the formulae by        #
#    MathJax and the theme doxygen-awesome-css (in build-docs/awesome),       #
#    which the workflow docs.yml clones before it builds this and the site    #
#    of MkDocs; the reference goes to build-docs/api and is published under   #
#    /api/ of the pages of the repository.                                    #
#                                                                             #
#                                Donato Meoli                                 #
#                         Dipartimento di Informatica                         #
#                             Universita' di Pisa                             #
# --------------------------------------------------------------------------- #

PROJECT_NAME           = AStarSearch
PROJECT_BRIEF          = "Sequential and parallel A* search"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = README.md include src
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = include src
STRIP_FROM_INC_PATH    = include src
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
EXCLUDE_SYMBOLS        = detail::* AStar_di_unipi_it::detail::*
GENERATE_HTML          = YES
HTML_OUTPUT            = api
HTML_EXTRA_STYLESHEET  = build-docs/awesome/doxygen-awesome.css \
                         build-docs/awesome/doxygen-awesome-sidebar-only.css
HTML_COLORSTYLE        = LIGHT
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
DOT_IMAGE_FORMAT       = svg
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = build-docs/warnings.txt

#############################################################################
#                              End of Doxyfile                              #
#############################################################################
